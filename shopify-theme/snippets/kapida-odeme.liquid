{% comment %}
  Kapida Odeme Snippet
  Dosya: snippets/kapida-odeme.liquid
  
  Kullanim: product.liquid veya main-product.liquid icerisine ekle:
    {% render 'kapida-odeme', product: product, variant: product.selected_or_first_available_variant %}
  
  NOT: BACKEND_URL'i kendi Next.js sunucunuzun adresiyle degistirin.
{% endcomment %}

{% assign backend_url = 'https://BACKEND-SUNUCUNUZ.com' %}

<div id="kapida-odeme-wrapper" style="margin-top:12px;">
  <button
    id="kapida-odeme-btn"
    type="button"
    data-variant-id="{{ variant.id }}"
    data-product-title="{{ product.title | escape }}"
    data-price="{{ variant.price | divided_by: 100.0 }}"
    style="
      display:inline-flex;
      align-items:center;
      gap:8px;
      background:#16a34a;
      color:#fff;
      border:none;
      border-radius:6px;
      padding:14px 24px;
      font-size:15px;
      font-weight:600;
      cursor:pointer;
      width:100%;
      justify-content:center;
    "
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a5 5 0 00-10 0v2M5 9h14l1 11H4L5 9z"/></svg>
    Kapida Odeme ile Satin Al
  </button>
</div>

<!-- MODAL -->
<div id="ko-modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9998;align-items:center;justify-content:center;">
  <div id="ko-modal" style="background:#fff;border-radius:12px;padding:28px 24px;width:94%;max-width:460px;max-height:92vh;overflow-y:auto;position:relative;box-shadow:0 20px 60px rgba(0,0,0,.3);">
    
    <button id="ko-close" type="button" style="position:absolute;top:14px;right:16px;background:none;border:none;font-size:22px;cursor:pointer;color:#555;">&times;</button>
    
    <h2 style="margin:0 0 20px;font-size:18px;font-weight:700;color:#111;">Kapida Odeme Formu</h2>

    <!-- ADIM 1: Kisisel Bilgiler -->
    <div id="ko-step-1">
      <div style="display:grid;gap:12px;">
        <div>
          <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;color:#374151;">Ad Soyad *</label>
          <input id="ko-fullname" type="text" placeholder="Ornek: Ahmet Yilmaz" style="width:100%;padding:10px 12px;border:1.5px solid #d1d5db;border-radius:6px;font-size:14px;box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;color:#374151;">Telefon Numarasi *</label>
          <input id="ko-phone" type="tel" placeholder="05xx xxx xx xx" maxlength="11" style="width:100%;padding:10px 12px;border:1.5px solid #d1d5db;border-radius:6px;font-size:14px;box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;color:#374151;">Il *</label>
          <input id="ko-city" type="text" placeholder="Istanbul" style="width:100%;padding:10px 12px;border:1.5px solid #d1d5db;border-radius:6px;font-size:14px;box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;color:#374151;">Ilce *</label>
          <input id="ko-district" type="text" placeholder="Kadikoy" style="width:100%;padding:10px 12px;border:1.5px solid #d1d5db;border-radius:6px;font-size:14px;box-sizing:border-box;" />
        </div>
        <div>
          <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;color:#374151;">Acik Adres *</label>
          <textarea id="ko-address" rows="2" placeholder="Mahalle, sokak, bina no, daire no..." style="width:100%;padding:10px 12px;border:1.5px solid #d1d5db;border-radius:6px;font-size:14px;resize:vertical;box-sizing:border-box;"></textarea>
        </div>
        <div>
          <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;color:#374151;">Adet *</label>
          <input id="ko-qty" type="number" value="1" min="1" max="99" style="width:80px;padding:10px 12px;border:1.5px solid #d1d5db;border-radius:6px;font-size:14px;" />
        </div>
      </div>
      <div id="ko-step1-error" style="color:#dc2626;font-size:13px;margin-top:8px;display:none;"></div>
      <button id="ko-send-otp-btn" type="button" style="margin-top:16px;width:100%;background:#16a34a;color:#fff;border:none;border-radius:6px;padding:12px;font-size:15px;font-weight:600;cursor:pointer;">
        SMS Dogrulama Kodu Gonder
      </button>
    </div>

    <!-- ADIM 2: OTP Dogrulama -->
    <div id="ko-step-2" style="display:none;">
      <p style="font-size:14px;color:#374151;margin:0 0 16px;">
        <strong id="ko-phone-display"></strong> numarasina 6 haneli dogrulama kodu gonderildi.
      </p>
      <div>
        <label style="display:block;font-size:13px;font-weight:600;margin-bottom:4px;color:#374151;">Dogrulama Kodu *</label>
        <input id="ko-otp" type="text" maxlength="6" placeholder="123456" style="width:100%;padding:12px;border:1.5px solid #d1d5db;border-radius:6px;font-size:20px;letter-spacing:6px;text-align:center;box-sizing:border-box;" />
      </div>
      <div id="ko-step2-error" style="color:#dc2626;font-size:13px;margin-top:8px;display:none;"></div>
      <button id="ko-verify-btn" type="button" style="margin-top:14px;width:100%;background:#16a34a;color:#fff;border:none;border-radius:6px;padding:12px;font-size:15px;font-weight:600;cursor:pointer;">
        Kodu Dogrula ve Siparisi Tamamla
      </button>
      <button id="ko-resend-btn" type="button" style="margin-top:8px;width:100%;background:none;border:1.5px solid #d1d5db;border-radius:6px;padding:10px;font-size:13px;color:#555;cursor:pointer;">
        Kodu Tekrar Gonder
      </button>
    </div>

    <!-- ADIM 3: Basarili -->
    <div id="ko-step-3" style="display:none;text-align:center;padding:16px 0;">
      <div style="font-size:48px;margin-bottom:12px;">&#10003;</div>
      <h3 style="color:#16a34a;margin:0 0 8px;">Siparisunuz Alindi!</h3>
      <p id="ko-order-info" style="font-size:14px;color:#555;margin:0;"></p>
      <button id="ko-done-btn" type="button" style="margin-top:20px;background:#16a34a;color:#fff;border:none;border-radius:6px;padding:12px 32px;font-size:15px;font-weight:600;cursor:pointer;">Kapat</button>
    </div>

    <div id="ko-loading" style="display:none;text-align:center;padding:20px 0;">
      <div style="display:inline-block;width:32px;height:32px;border:3px solid #d1d5db;border-top-color:#16a34a;border-radius:50%;animation:ko-spin 0.8s linear infinite;"></div>
    </div>
  </div>
</div>

<style>
@keyframes ko-spin { to { transform: rotate(360deg); } }
#ko-modal input:focus, #ko-modal textarea:focus {
  outline: none;
  border-color: #16a34a;
  box-shadow: 0 0 0 3px rgba(22,163,74,.15);
}
</style>

<script>
(function() {
  const BACKEND = '{{ backend_url }}';

  const overlay   = document.getElementById('ko-modal-overlay');
  const btn       = document.getElementById('kapida-odeme-btn');
  const closeBtn  = document.getElementById('ko-close');
  const step1     = document.getElementById('ko-step-1');
  const step2     = document.getElementById('ko-step-2');
  const step3     = document.getElementById('ko-step-3');
  const loading   = document.getElementById('ko-loading');

  let verifiedPhone = '';
  let currentVariantId   = btn.dataset.variantId;
  let currentProductTitle = btn.dataset.productTitle;
  let currentPrice        = btn.dataset.price;

  // Varyant degisimini dinle (Shopify tema event'i)
  document.addEventListener('variant:changed', function(e) {
    const variant = e.detail?.variant;
    if (variant) {
      btn.dataset.variantId    = variant.id;
      btn.dataset.price        = (variant.price / 100).toFixed(2);
      currentVariantId         = variant.id;
      currentPrice             = btn.dataset.price;
    }
  });

  function showLoading(show) {
    loading.style.display = show ? 'block' : 'none';
  }

  function showError(stepNum, msg) {
    const el = document.getElementById('ko-step' + stepNum + '-error');
    el.textContent = msg;
    el.style.display = msg ? 'block' : 'none';
  }

  function setStep(n) {
    step1.style.display = n === 1 ? 'block' : 'none';
    step2.style.display = n === 2 ? 'block' : 'none';
    step3.style.display = n === 3 ? 'block' : 'none';
  }

  btn.addEventListener('click', function() {
    overlay.style.display = 'flex';
    setStep(1);
    showError(1, '');
    showError(2, '');
    showLoading(false);
  });

  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) closeModal();
  });
  document.getElementById('ko-done-btn').addEventListener('click', closeModal);

  function closeModal() {
    overlay.style.display = 'none';
    setStep(1);
    showLoading(false);
    showError(1, '');
    showError(2, '');
  }

  document.getElementById('ko-send-otp-btn').addEventListener('click', sendOtp);
  document.getElementById('ko-resend-btn').addEventListener('click', sendOtp);
  document.getElementById('ko-verify-btn').addEventListener('click', verifyAndOrder);

  async function sendOtp() {
    const fullname = document.getElementById('ko-fullname').value.trim();
    const phone    = document.getElementById('ko-phone').value.trim();
    const city     = document.getElementById('ko-city').value.trim();
    const district = document.getElementById('ko-district').value.trim();
    const address  = document.getElementById('ko-address').value.trim();
    const qty      = document.getElementById('ko-qty').value;

    if (!fullname || !phone || !city || !district || !address || !qty) {
      showError(1, 'Lutfen tum alanlari doldurun.');
      return;
    }
    if (!/^[0-9\s\-\+]{10,13}$/.test(phone)) {
      showError(1, 'Gecerli bir telefon numarasi girin (05xx xxx xx xx).');
      return;
    }

    showError(1, '');
    showLoading(true);

    try {
      const res = await fetch(BACKEND + '/api/send-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone }),
      });
      const data = await res.json();
      showLoading(false);

      if (!res.ok) {
        showError(1, data.error || 'SMS gonderilemedi.');
        return;
      }

      verifiedPhone = data.phone;
      document.getElementById('ko-phone-display').textContent = verifiedPhone;
      document.getElementById('ko-otp').value = '';
      setStep(2);
    } catch(e) {
      showLoading(false);
      showError(1, 'Sunucuya baglanılamadi. Lutfen tekrar deneyin.');
    }
  }

  async function verifyAndOrder() {
    const code = document.getElementById('ko-otp').value.trim();
    if (code.length !== 6) {
      showError(2, '6 haneli kodu girin.');
      return;
    }

    showError(2, '');
    showLoading(true);

    try {
      // 1) OTP dogrula
      const vRes = await fetch(BACKEND + '/api/verify-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone: verifiedPhone, code }),
      });
      const vData = await vRes.json();

      if (!vRes.ok) {
        showLoading(false);
        showError(2, vData.error || 'Kod hatali.');
        return;
      }

      // 2) Siparis olustur
      const oRes = await fetch(BACKEND + '/api/create-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fullName:     document.getElementById('ko-fullname').value.trim(),
          phone:        verifiedPhone,
          city:         document.getElementById('ko-city').value.trim(),
          district:     document.getElementById('ko-district').value.trim(),
          address:      document.getElementById('ko-address').value.trim(),
          quantity:     Number(document.getElementById('ko-qty').value),
          variantId:    btn.dataset.variantId,
          productTitle: btn.dataset.productTitle,
          price:        btn.dataset.price,
        }),
      });
      const oData = await oRes.json();
      showLoading(false);

      if (!oRes.ok) {
        showError(2, oData.error || 'Siparis olusturulamadi.');
        return;
      }

      document.getElementById('ko-order-info').textContent =
        'Siparis No: ' + oData.orderName + ' — Kapida odeme ile teslimatta odersiniz.';
      setStep(3);
    } catch(e) {
      showLoading(false);
      showError(2, 'Sunucuya baglanılamadi. Lutfen tekrar deneyin.');
    }
  }
})();
</script>
