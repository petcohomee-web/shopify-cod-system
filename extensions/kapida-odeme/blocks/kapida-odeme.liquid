{% comment %}
  App Block — kapida-odeme/blocks/kapida-odeme.liquid
  Ürün sayfasına tema editöründen "Add block" ile eklenir.
  Butonu render eder; modal App Embed tarafından sağlanır.
{% endcomment %}

{% assign btn_color  = block.settings.button_color  | default: '#16a34a' %}
{% assign btn_text   = block.settings.button_text   | default: 'Kapıda Ödeme ile Satın Al' %}
{% assign btn_radius = block.settings.button_radius | default: 6 %}

<div
  class="ko-trigger-wrapper"
  {{ block.shopify_attributes }}
  style="margin-top:{{ block.settings.margin_top }}px; margin-bottom:{{ block.settings.margin_bottom }}px;"
>
  <button
    type="button"
    class="ko-trigger-btn"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-product-title="{{ product.title | escape }}"
    data-price="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}"
    style="
      background: {{ btn_color }};
      border-radius: {{ btn_radius }}px;
    "
    aria-haspopup="dialog"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none"
         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round"
            d="M17 9V7a5 5 0 00-10 0v2M5 9h14l1 11H4L5 9z"/>
    </svg>
    {{ btn_text }}
  </button>
</div>

{% schema %}
{
  "name": "Kapıda Ödeme Butonu",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Buton Yazısı",
      "default": "Kapıda Ödeme ile Satın Al"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Buton Rengi",
      "default": "#16a34a"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Köşe Yuvarlama",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Üst Boşluk",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Alt Boşluk",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Kapıda Ödeme Butonu"
    }
  ]
}
{% endschema %}
